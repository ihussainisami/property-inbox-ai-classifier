    {
      "parameters": {
        "jsCode": "const item = items[0];\n\nconst rawBody = item.json.textPlain || item.json.textHtml || \"\";\nconst cleanBody = rawBody.replace(/\\s+/g, ' ').trim();\nconst truncatedBody = cleanBody.length > 500 ? cleanBody.substring(0, 500) + \"...\" : cleanBody;\n\nreturn {\n  json: {\n    ...item.json,\n    original_body: truncatedBody\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1072,
        1232
      ],
      "id": "",
      "name": "Sanitize Email Body"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n\"model\": \"qwen/qwen3.6-27b\",\n  \"reasoning_effort\": \"none\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an AI email classification and response engine for a property management and real estate operations team.\\n\\nAnalyze the incoming email and return ONLY a valid JSON object. Do not include any markdown formatting, code blocks, or conversational text before or after the JSON. The JSON must contain exactly four keys:\\n\\n1. 'category': Must be EXACTLY one of these five strings, with this exact spelling and capitalization: 'Maintenance', 'Tenant Query', 'Viewing', 'Enquiry', 'Spam'.\\n   - 'Maintenance': repairs, urgent property issues, faults (heating, plumbing, appliances, lockouts).\\n   - 'Tenant Query': lease questions, rent/payment queries, complaints, general tenant/client communication.\\n   - 'Viewing': requests to book, reschedule, or cancel a property viewing/appointment.\\n   - 'Enquiry': new prospective enquiries about property availability, pricing, details, OR any short, vague, unclear, or minimal-content message (greetings, test messages, single words, incomplete sentences) that does not clearly fit another category.\\n   - 'Spam': unwanted, promotional, or malicious emails, AND automated platform alerts, newsletters, or receipts that do not require a human reply.\\n\\n   IMPORTANT: Always choose one of these five exact strings. Never return a category based on the literal words in the email (for example, do not return the word 'hi' as a category just because the email says 'hi'). If the email is too short or unclear to confidently classify, default to 'Enquiry', not any other value.\\n\\n2. 'urgency': An integer from 1 (lowest) to 5 (highest). Maintenance issues involving safety (no heating, water leak, lockout, gas smell) must be urgency 4-5. Spam must always be urgency 1. Vague or short messages default to urgency 2.\\n\\n3. 'property_reference': Extract any property address, unit number, or reference mentioned in the email. If none is found, return an empty string. Never return null and never omit this key.\\n\\n4. 'suggested_reply': A professional, polite, contextual email response addressing the message. Keep it under 150 words. If the email is too vague to respond to meaningfully, write a brief friendly reply asking the sender to share more details about their property enquiry, maintenance issue, or query.\\n\\nCRITICAL RULES:\\n- Output ONLY the JSON object. No preamble, no explanation, no markdown.\\n- All four keys must always be present with correctly typed values.\\n- If the category is 'Spam', set suggested_reply to 'N/A' and do not generate a draft reply.\\n- Never invent a fifth category and never leave category blank.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Email Details:\\nSubject: {{ $json.subject || 'No Subject' }}\\n\\nBody: {{ $('Sanitize Email Body').item.json.original_body || 'Empty Body' }}\"\n    }\n  ],\n  \"response_format\": { \"type\": \"json_object\" },\n  \"temperature\": 0\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -864,
        1232
      ],
      "id": "",
      "name": "Classify Ticket via Groq",
      "retryOnFail": true,
      "maxTries": 5,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "let parsedData = {};\ntry {\n  const item = items[0];\n  const rawContent = item.json.choices[0].message.content;\n  parsedData = JSON.parse(rawContent);\n} catch (error) {\n  parsedData = {\n    category: \"manual_review\",\n    urgency: 3,\n    property_reference: \"\",\n    suggested_reply: \"Dear Customer,\\n\\nWe have received your request and our team is reviewing it.\\n\\nBest regards,\\nProperty Support Team\",\n    parsing_error: true\n  };\n}\n\n// ---------- Map numeric urgency (1-5) to Airtable-compatible text label ----------\nconst urgencyMap = {\n  1: 'Low',\n  2: 'Low',\n  3: 'Medium',\n  4: 'High',\n  5: 'Critical'\n};\nconst urgencyLabel = urgencyMap[parsedData.urgency] || 'Medium';\n\n// Validate the category returned by the AI\nconst validCategories = [\"Maintenance\", \"Tenant Query\", \"Viewing\", \"Enquiry\", \"Spam\"];\nconst finalCategory = validCategories.includes(parsedData.category) ? parsedData.category : \"manual_review\";\n\n// Clear the reply text for Spam only\nconst finalReply = (finalCategory === \"Spam\")\n  ? \"N/A \u2014 No reply generated for spam.\"\n  : (parsedData.suggested_reply || \"Thank you for reaching out. We are looking into your issue.\");\n\n// ---------- Extract sender details (correct method + strong regex) ----------\nlet rawSender = \"unknown@domain.com\";\ntry {\n  // Use $('...') instead of $node for reliable node referencing\n  const imapNode = $('Email Trigger (IMAP)').item.json;\n  if (imapNode.from?.value?.[0]?.address) {\n    const fromData = imapNode.from.value[0];\n    rawSender = fromData.name ? `${fromData.name} <${fromData.address}>` : fromData.address;\n  } else if (imapNode.from?.address) {\n    rawSender = imapNode.from.address;\n  } else if (typeof imapNode.from === 'string') {\n    rawSender = imapNode.from;\n  }\n} catch (e) {\n  // If anything fails here, keep the default fallback value\n}\n\nlet cleanEmail = \"unknown@domain.com\";\nlet cleanName = \"Unknown\";\n\n// Case with angle brackets: \"Name <email>\"\nconst angleBracketMatch = rawSender.match(/(.*?)\\s*<([^>]+)>/);\nif (angleBracketMatch) {\n  cleanName = angleBracketMatch[1].replace(/[\"']/g, \"\").trim() || \"Unknown\";\n  cleanEmail = angleBracketMatch[2].trim().toLowerCase();\n} else {\n  // Strong regex \u2014 extracts only a valid email address\n  const emailRegex = /\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b/;\n  const match = rawSender.match(emailRegex);\n  if (match) {\n    cleanEmail = match[0].trim().toLowerCase();\n  }\n}\n\n// Get original subject and body\nlet originalSubject = \"No Subject\";\nlet originalBody = \"Empty Body\";\ntry {\n  originalSubject = $('Email Trigger (IMAP)').item.json.subject || \"No Subject\";\n  originalBody = $('Sanitize Email Body').item.json.original_body || \"Empty Body\";\n} catch(e) {}\n\n// ---------- FINAL OUTPUT ----------\nreturn {\n  json: {\n    category: finalCategory,\n    urgency: urgencyLabel,  // Now \"Low\"/\"Medium\"/\"High\"/\"Critical\" \u2014 ready for Airtable\n    property_reference: parsedData.property_reference || \"\",\n    suggested_reply: finalReply,\n    original_subject: originalSubject,\n    original_body: originalBody,\n    sender_name: cleanName,\n    sender_email: cleanEmail\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -512,
        1216
      ],
      "id": "",
      "name": "Parse Classification & Sender",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const errorItem = items[0];\nconst errorMsg = errorItem.json.error || errorItem.json.message || \"Unknown API error\";\n\n// Convert the error into a manual_review item so the workflow does not stop\nreturn [{\n  json: {\n    category: \"manual_review\",\n    urgency: \"Medium\",\n    property_reference: \"\",\n    suggested_reply: `System error: ${errorMsg}. Please handle manually.`,\n    original_subject: errorItem.json.original_subject || \"Error Subject\",\n    original_body: errorItem.json.original_body || \"Error Body\",\n    sender_name: \"System Alert\",\n    sender_email: \"alert@system.local\",\n    error_alert: errorMsg\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
